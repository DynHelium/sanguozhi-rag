# 复制为 .env 后填写；.env 不进 git
# 默认用 DeepSeek V4.1 Flash，经 OpenRouter（OpenAI 兼容接口）调用；也可以改用 Claude Haiku 5.5（见文件末尾）

# OpenRouter 的 key（接口地址固定是 OpenRouter，暂时不支持本地模型）
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_REASONING_EFFORT=low
# 经 OpenRouter 时只用这几家服务商, 按顺序优先; 留空 (LLM_PROVIDERS=) 由 OpenRouter 自己选. 见 rag/config.py
LLM_PROVIDERS=InferenceNet,GMICloud

# Embedding 在本地跑。换 EMBED_MODEL 必须重建索引。
EMBED_MODEL=BAAI/bge-m3

# 改用 Claude Haiku 5.5（Claude 原生接口, 先 uv sync --extra anthropic）: 取消下面几行的注释, 并注释掉上面的 LLM_MODEL
# LLM_BACKEND=anthropic
# LLM_MODEL=claude-haiku-5-5
# LLM_REASONING_EFFORT=medium   # Haiku 用 medium: 62 题实测比 low 多对 4 题, 花费多约 12%; high 不更好
# ANTHROPIC_API_KEY=
