# 复制为 .env 后填写；.env 不进 git
# 本项目的大模型固定用 DeepSeek V4.1 Flash，经 OpenRouter（OpenAI 兼容接口）调用

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_REASONING_EFFORT=low
# 经 OpenRouter 时只用这几家服务商, 按顺序优先; 留空 (LLM_PROVIDERS=) 由 OpenRouter 自己选. 见 rag/config.py
LLM_PROVIDERS=InferenceNet,GMICloud

# Embedding 在本地跑。换 EMBED_MODEL 必须重建索引。
EMBED_MODEL=BAAI/bge-m3
